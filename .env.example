# ── Slack ── https://api.slack.com/apps → your app
SLACK_SIGNING_SECRET="your-slack-signing-secret"
SLACK_BOT_TOKEN="xoxb-..."

# ── GitHub App (owned by the posterai org) ──
# Org settings → Developer settings → GitHub Apps → PosterChild bot
GITHUB_APP_ID="123456"
# The app's private key (.pem). Newlines may be literal or written as \n.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# From the installation's URL: github.com/organizations/posterai/settings/installations/<id>
GITHUB_APP_INSTALLATION_ID="12345678"

# ── Review sandboxes (/sandbox) ──
# Channel IDs where /sandbox works, comma-separated (e.g. the sandbox channel).
SANDBOX_ALLOWED_CHANNEL_IDS="C0123456789"
# E2B key for the team that owns the pcai-fullstack sandboxes (read status).
E2B_API_KEY="e2b_..."
# Defaults; override only if pcaicode changes them.
# SANDBOX_REPO="posterai/pcaicode"
# SANDBOX_WORKFLOW="sandbox.yml"
# SANDBOX_WORKFLOW_REF="main"
# SANDBOX_PR_LABEL="sandbox"
# SANDBOX_E2B_TEMPLATE="pcai-fullstack"   # pcaicode e2b/config.ts TEMPLATE_NAME
# SANDBOX_APP_PORT="8090"                 # pcaicode e2b/config.ts TENANT_PORTS.app

# ── Local dev ── https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN="your-ngrok-auth-token"
