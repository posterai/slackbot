{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "PosterChild",
    "description": "PosterChild's internal tools in Slack.",
    "background_color": "#1d1c1d"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "PosterChild",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/sandbox",
        "description": "Start, pause, delete or list review sandboxes",
        "usage_hint": "[status | up|stop|destroy <#PR or name> | help]",
        "should_escape": false,
        "url": "https://<your-domain>/api/slack/events"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "commands"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://<your-domain>/api/slack/events",
      "bot_events": ["app_home_opened"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://<your-domain>/api/slack/events"
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
